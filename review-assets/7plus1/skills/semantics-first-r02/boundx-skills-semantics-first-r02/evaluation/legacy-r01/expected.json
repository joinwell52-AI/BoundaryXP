{
  "format": "boundx-skill-development-expectations/1",
  "model_input_allowed": false,
  "live_model_execution": "NOT_RUN",
  "not_boundx_native_schema": true,
  "cases": [
    {
      "id": "SR01",
      "topic": "输入排他性",
      "semantic_checks": [
        "允许外部域与检查义务分开；使用关系必须受排他约束。",
        "组成员等于相同常量集合，不能作为排他性已经完整表达的证明。",
        "1.2没有忠实的外部使用投影时应报告表达缺口，不能标EXPRESSED。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    },
    {
      "id": "SR02",
      "topic": "内部产物不是新增外部输入",
      "semantic_checks": [
        "seed.csv的外部身份与本次stage.md的生产/消费关系分别保留。",
        "不能因PM把stage.md当输入就把它加入根任务外部输入。",
        "原文没有生成者/来源的其他对象不能仅靠producer=null归类。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    },
    {
      "id": "SR03",
      "topic": "生成许可、无需交付和定向禁止",
      "semantic_checks": [
        "可选生成不是必产。",
        "无需交付不是禁止所有交付，也不是额外交付许可。",
        "向ADMIN交付是独立禁止，不应成为正向A/O许可；不扩大到所有接收者。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    },
    {
      "id": "SR04",
      "topic": "两个动作各有必要前提",
      "semantic_checks": [
        "生成和交付两个开始点分别受QA通过约束。",
        "不能写成只有两动作同时发生才需要QA通过。",
        "原文明确义务与必要前提分别保留；QA不是被命令必须判通过。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    },
    {
      "id": "SR05",
      "topic": "触发与定性立即",
      "semantic_checks": [
        "泄漏触发隔离和通知。",
        "立即仅明确约束隔离，不追加通知的零秒期限。",
        "操作类别不足时保留精确原意与缺口，不把OTHER误写为EXACT。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    },
    {
      "id": "SR06",
      "topic": "收到、提交与通过",
      "semantic_checks": [
        "提交发生、收到、复核和通过分开。",
        "收到是复核的时间/触发要求，QA通过是发布前提。",
        "不能凭“提交”推收件时点，不能凭“复核”推通过。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    },
    {
      "id": "SR07",
      "topic": "同名不同版本",
      "semantic_checks": [
        "同名旧文件与本轮产物不得合并。",
        "QA使用必须指向OPS本轮生成的身份。",
        "背景用途不变成要求重新生成旧文件。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    },
    {
      "id": "SR08",
      "topic": "选择和有界重试",
      "semantic_checks": [
        "选择自由不是语义歧义，不预选文件。",
        "首次、重试、总次数与直接前次状态分别保留。",
        "所有实例使用同一选定对象；不要求必须重试。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    },
    {
      "id": "SR09",
      "topic": "局部缺口与独立期限",
      "semantic_checks": [
        "输入排他性若合同不足，缺口只针对相应义项。",
        "明确期限及其任务身份仍能独立编码。",
        "完整计算可因必要缺口受阻，但不能把已知数值改成语义未知。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    },
    {
      "id": "SR10",
      "topic": "共享预算",
      "semantic_checks": [
        "两个局部数量与一个团队共同上限均保留。",
        "不能把共享上限复制成各角色可独立使用四次。",
        "LLM表示约束，最终合计及可行分配由程序计算。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    },
    {
      "id": "SR11",
      "topic": "开发行为与产物行为分层",
      "semantic_checks": [
        "开发者对源码的修改许可与被开发CLI对输入的禁止属于不同层次。",
        "不能把CLI禁止写输入扩成DEV不得改源码。",
        "现有IR无法保留产物行为层时报告表达缺口，不扁平混入当前执行事件。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    },
    {
      "id": "SR12",
      "topic": "只读范围明确例外",
      "semantic_checks": [
        "只读对象是受检配置，不是所有可能文件。",
        "写results是明确要求，不能判为与配置只读矛盾。",
        "不因例外允许任意写其他目录。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    },
    {
      "id": "SR13",
      "topic": "引文不执行",
      "semantic_checks": [
        "引文作为报告内容保存，不创建必须删除的当前动作。",
        "禁止真实删除另作边界。",
        "原文中的指令文字不改变解析器职责。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    },
    {
      "id": "SR14",
      "topic": "完成定义不吸收全部约束",
      "semantic_checks": [
        "完成充要式只含提交和收件。",
        "时限独立保留；不把它偷偷加入完成公式。",
        "没有执行观测时保留符号状态，不制造假/真值。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    },
    {
      "id": "SR15",
      "topic": "自足任务允许维度缺省",
      "semantic_checks": [
        "保留PM安排、DEV检查和汇报责任的原文指向；主语不唯一时局部核对。",
        "原文没有时限、预算、文件命名，不补出数字或路径。",
        "不是每个7+1维度都要有非空内容。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    },
    {
      "id": "SR16",
      "topic": "明确承认的指代歧义",
      "semantic_checks": [
        "原文明示的身份竞争应保留为AMBIGUITY。",
        "不能为了满足Schema任取一人。",
        "两份收到报告的事实不因为复核者未定全部失去表达。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    },
    {
      "id": "SR17",
      "topic": "父职责与已有分工",
      "semantic_checks": [
        "源文明示的父要求、已新增子任务和开放规划状态分开。",
        "不自行生成另两项任务，也不判只有一个子任务就已越界。",
        "PM最终汇报责任不随分工消失；完整组合证明不由LLM签发。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    },
    {
      "id": "SR18",
      "topic": "类别全称不能缩成枚举",
      "semantic_checks": [
        "类别全称包括后续相关成员，不能只枚举当前已知配置项。",
        "禁止修改与允许读取分开。",
        "无类型化类别域表达时保留明确缺口，不把空集合当全称边界。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    },
    {
      "id": "SR19",
      "topic": "充分条件不是必要条件",
      "semantic_checks": [
        "收到回执触发归档义务。",
        "不能增加未收到就禁止归档的反向限制。",
        "不把未限定的其他情形擅自授予权限。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    },
    {
      "id": "SR20",
      "topic": "过去陈述不取消规则",
      "semantic_checks": [
        "规则仍是双提交前提，不被背景状态简化删除。",
        "背景真伪不由解析/审阅模型运行系统核验。",
        "没有本段当前启动要求，不新增必须立即复核的事件义务。"
      ],
      "oracle_type": "AUTHOR_REVIEW_CHECKLIST_NOT_EXECUTED",
      "successful_expression_is_not_guaranteed_by_schema": true
    }
  ]
}
