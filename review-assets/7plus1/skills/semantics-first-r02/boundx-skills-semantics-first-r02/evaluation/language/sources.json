  "cases": [
    {
      "id": "BI01-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI01",
      "text": "DEV检查ledger.tsv，生成receipt.md并将该报告提交QA。",
      "codepoints": 38,
      "sha256_utf8": "825d7933f91a2e93fe7bf58669d1be4d5af2918aca90dd18e9df0b66868d9c20",
      "file": "texts/BI01-zh-CN.txt",
      "sha256_utf8_with_final_LF": "b6c958f92f6a2da3b51e6ad4a8ff09f46c838e67f74c66fc58f61f4365b7367a"
    },
    {
      "id": "BI01-en",
      "language": "en",
      "pair_id": "BI01",
      "text": "DEV, inspect ledger.tsv, create receipt.md, and submit that report to QA.",
      "codepoints": 73,
      "sha256_utf8": "f3adeb745e469d264b810e353232a3c51c93975777a217af880d5daedf585b9d",
      "file": "texts/BI01-en.txt",
      "sha256_utf8_with_final_LF": "31d2bea5f9c5037837f628e72f8647b4700771e37700f46d34c2a548a05760d7"
    },
    {
      "id": "BI02-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI02",
      "text": "DEV可以生成memo.md；生成它不是本任务的义务。",
      "codepoints": 27,
      "sha256_utf8": "f62fa2c8de4b28153342bdf6839779a1c77c67286edf0fa6963e216a7474ac42",
      "file": "texts/BI02-zh-CN.txt",
      "sha256_utf8_with_final_LF": "e8ac48c1679df6131a840c6cfc80e2f7dce39dd1c6107e21ffcc47a55ce9e231"
    },
    {
      "id": "BI02-en",
      "language": "en",
      "pair_id": "BI02",
      "text": "DEV may create memo.md; creating it is not an obligation of this task.",
      "codepoints": 70,
      "sha256_utf8": "0a0b1dd7f31a7dad4511997426043737313ba9f7b463ad3441cc5546d30335dc",
      "file": "texts/BI02-en.txt",
      "sha256_utf8_with_final_LF": "317cf4c4de58c855fd9db4cb0e8ee21c3858dc8bf8d3b762c065e9ddeab4c4ca"
    },
    {
      "id": "BI03-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI03",
      "text": "PM无需将memo.md交给ADMIN；本句既不授予该交付许可，也不禁止该交付。",
      "codepoints": 40,
      "sha256_utf8": "54b3a53800677253d714796d08a71e89a97c6a4010bb0447425b3403bfd90620",
      "file": "texts/BI03-zh-CN.txt",
      "sha256_utf8_with_final_LF": "683ebb5a87bfd75d8cfc7ae3249ac9d4ab26df7f400958a80f9230df46ebc355"
    },
    {
      "id": "BI03-en",
      "language": "en",
      "pair_id": "BI03",
      "text": "PM is not required to deliver memo.md to ADMIN; this sentence neither grants nor prohibits that delivery.",
      "codepoints": 105,
      "sha256_utf8": "1eb5a80c294959456ba6dd464e081e23367f27e925813ae5fbddf872148da87f",
      "file": "texts/BI03-en.txt",
      "sha256_utf8_with_final_LF": "40877904d91df4a7d86af83f844e806f8cbc88f7b98ed00a6766312d209926a0"
    },
    {
      "id": "BI04-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI04",
      "text": "本任务禁止PM向ADMIN交付memo.md。",
      "codepoints": 23,
      "sha256_utf8": "a0034f3c0bcd5f9ba68284408f422a4747f674e63760383cbeb32abaf2f01ce0",
      "file": "texts/BI04-zh-CN.txt",
      "sha256_utf8_with_final_LF": "9b9f8ab3b0725d257cad0a7ff450d3f5b01d7ed972c69401d2d177d6d94d4c3c"
    },
    {
      "id": "BI04-en",
      "language": "en",
      "pair_id": "BI04",
      "text": "In this task, PM must not deliver memo.md to ADMIN.",
      "codepoints": 51,
      "sha256_utf8": "ced02bcbf7c0ac4388444033bdb81fc51bde18f372d3b6330e7209f101e2a9cb",
      "file": "texts/BI04-en.txt",
      "sha256_utf8_with_final_LF": "a9fad33e8d08e28886b71d58a4d4bc87d53cf79ca1bc73482141b8d6e06cdf75"
    },
    {
      "id": "BI05-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI05",
      "text": "只有QA复核通过，PM才能生成brief.md或交付brief.md给ADMIN；PM必须完成这两项工作。",
      "codepoints": 53,
      "sha256_utf8": "27d1cc44405221ebf3a4a6be061eb23c2e12f8616a2743599ab8a5778780de2c",
      "file": "texts/BI05-zh-CN.txt",
      "sha256_utf8_with_final_LF": "5449b51e22728eb26b20f0d36c450cb8e2aa2966d1f172358d64d0a77e7c511c"
    },
    {
      "id": "BI05-en",
      "language": "en",
      "pair_id": "BI05",
      "text": "PM may start creating brief.md or delivering brief.md to ADMIN only if QA has approved the review; PM must perform both actions.",
      "codepoints": 128,
      "sha256_utf8": "c2c15cc01917d4a4f9980a29be44114b222295a09ea510e847d7ed4139e2e05f",
      "file": "texts/BI05-en.txt",
      "sha256_utf8_with_final_LF": "94a43a50733a0588c32d7299f1205a7e73fbe5fbc0b65e8d339ef86c2e27b4c1"
    },
    {
      "id": "BI06-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI06",
      "text": "每当QA收到有效回执，QA必须归档该回执。本条未规定其他情况下禁止归档。",
      "codepoints": 36,
      "sha256_utf8": "cd6bdf6dc070082b3c29a7357e5772fda9f3c4c36076ad67bd1b5cd6542c0c48",
      "file": "texts/BI06-zh-CN.txt",
      "sha256_utf8_with_final_LF": "02fa57a525d32ba7baca11bf7fec344d726924c2fcc85094b601b0ea6fe12064"
    },
    {
      "id": "BI06-en",
      "language": "en",
      "pair_id": "BI06",
      "text": "Whenever QA receives a valid receipt, QA must archive that receipt. This rule does not prohibit archiving in other circumstances.",
      "codepoints": 129,
      "sha256_utf8": "7e9ea1378edfc9362eeb598e9edb9e1feec79a3168bc53dbfff1b4d86f16423d",
      "file": "texts/BI06-en.txt",
      "sha256_utf8_with_final_LF": "95b14a3335dcf9d14be3a49465710182bac30d9dedef0347296488a44dc7e534"
    },
    {
      "id": "BI07-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI07",
      "text": "任务完成当且仅当记录已提交且回执已收到。任务总耗时不超过11分钟。",
      "codepoints": 33,
      "sha256_utf8": "3585cd94ca1a222092811751a8a17c454fea3be22e846de1ac3097db81e4b3af",
      "file": "texts/BI07-zh-CN.txt",
      "sha256_utf8_with_final_LF": "5aa746cbd44c356f4b18b15008bb07ed1236760c6f0b30c5147dc1301751b177"
    },
    {
      "id": "BI07-en",
      "language": "en",
      "pair_id": "BI07",
      "text": "The task is complete if and only if the record has been submitted and the receipt has been received. Total task duration must not exceed 11 minutes.",
      "codepoints": 148,
      "sha256_utf8": "a92e459d6663ebe7c16dc266684ffc6eb9eaf1685c41aa3cac921b9e4a6af3f9",
      "file": "texts/BI07-en.txt",
      "sha256_utf8_with_final_LF": "9b7f9d337c18630378cf6fc1aa1673aea8257113633f241bc09f4238d395f90d"
    },
    {
      "id": "BI08-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI08",
      "text": "除非QA已批准本次交付，否则禁止PM交付package.zip；QA批准本身不自动授予交付许可。",
      "codepoints": 48,
      "sha256_utf8": "798234f465ac46749f5ea0346f6ddb6bae6b59b315f87082e0c1f8996f421c4f",
      "file": "texts/BI08-zh-CN.txt",
      "sha256_utf8_with_final_LF": "a91281dfed24f72899ce952ccc01b34b3c92fffbba9e7acc53ed66d5131229e8"
    },
    {
      "id": "BI08-en",
      "language": "en",
      "pair_id": "BI08",
      "text": "PM must not deliver package.zip unless QA has approved this delivery; QA approval alone does not grant delivery permission.",
      "codepoints": 123,
      "sha256_utf8": "7b3c934cf6eda8b96b98e12c57594002d81e45caf316cdeac4a5eadf49f06b78",
      "file": "texts/BI08-en.txt",
      "sha256_utf8_with_final_LF": "07931ac9f28a97a35b2686389b365f0c7391cad282eb1f83145ecee992e1a3ac"
    },
    {
      "id": "BI09-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI09",
      "text": "禁止OPS删除logs目录中的任何文件，keep.txt除外。本条不授予删除keep.txt的许可。",
      "codepoints": 50,
      "sha256_utf8": "dedd881797ee832f93674916416da27c0e4aad5bb1b72eac26e50c883eb253db",
      "file": "texts/BI09-zh-CN.txt",
      "sha256_utf8_with_final_LF": "3568eae9127db5de5d811ee04d9cce78914731c0091c3ec2ea41158a89b8adf5"
    },
    {
      "id": "BI09-en",
      "language": "en",
      "pair_id": "BI09",
      "text": "OPS must not delete any file in the logs directory except keep.txt. This rule does not grant permission to delete keep.txt.",
      "codepoints": 123,
      "sha256_utf8": "94f4954413cb7242b0685307e8b5d912caa37e526d39d7284162c316817bebe4",
      "file": "texts/BI09-en.txt",
      "sha256_utf8_with_final_LF": "4ee8ae14fe0878030fa6ca2904aa9de54dd23b3575f57eaed12bc611909cfecd"
    },
    {
      "id": "BI10-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI10",
      "text": "DEV必须从red.csv和blue.csv中恰选一个读取；本任务选定后不得更换。",
      "codepoints": 41,
      "sha256_utf8": "c3342e64072970876745072f710503baed7cf0d98deb3fc27bf980b1e0c91067",
      "file": "texts/BI10-zh-CN.txt",
      "sha256_utf8_with_final_LF": "c63d5f5063da63a28a9c08a6ddb19ef9f77927dd4e241d5386ffbd6e8931dc79"
    },
    {
      "id": "BI10-en",
      "language": "en",
      "pair_id": "BI10",
      "text": "DEV must choose exactly one of red.csv and blue.csv to read; after selection, that choice must not change during this task.",
      "codepoints": 123,
      "sha256_utf8": "bcd78c8158b24303398cbb8fb299a197dcc37d5038e117e6cea19abf94af863e",
      "file": "texts/BI10-en.txt",
      "sha256_utf8_with_final_LF": "c6e8a8302729ee3f3b4b4cb08eb6883555ada15b549d6c068697404593915c1d"
    },
    {
      "id": "BI11-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI11",
      "text": "DEV必须检查所有本次提供的输入，包括red.csv和blue.csv；这两个文件名不是完整输入清单。",
      "codepoints": 51,
      "sha256_utf8": "98932a7b475af215b2ea313bfb007c0eea63b56c73105d2efa520bc78750f9d2",
      "file": "texts/BI11-zh-CN.txt",
      "sha256_utf8_with_final_LF": "8032f05a4ff6b8fbd03f11ddc77f5b0d770208578b4c049545a6a409d89c44a7"
    },
    {
      "id": "BI11-en",
      "language": "en",
      "pair_id": "BI11",
      "text": "DEV must inspect all inputs supplied for this task, including red.csv and blue.csv; those two names are not an exhaustive input list.",
      "codepoints": 133,
      "sha256_utf8": "8778f3efa1a868a08a3dcf7316c67f7f204ca93be707af5a9bea83d84379fde4",
      "file": "texts/BI11-en.txt",
      "sha256_utf8_with_final_LF": "64aa302101f3fa3c4c35604426d9a338419efaa7a7af81f6fa22e2fdc1e9b5ac"
    },
    {
      "id": "BI12-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI12",
      "text": "DEV必须首次读取seed.dat。仅在紧邻上次读取失败后，DEV可重试同一文件；最多重试2次，不含首次。",
      "codepoints": 53,
      "sha256_utf8": "a4c6d4591132e224fdcec805580f93cbe99a3bdf905b65cfd1d3a80db1d0f1b4",
      "file": "texts/BI12-zh-CN.txt",
      "sha256_utf8_with_final_LF": "667db0ec5ed9ef5a9a886e9b2dd08ac0692c00ede920f0d1b5970a67109e415b"
    },
    {
      "id": "BI12-en",
      "language": "en",
      "pair_id": "BI12",
      "text": "DEV must make the initial read attempt on seed.dat. Only after the immediately preceding read attempt fails may DEV retry the same file, for at most 2 retries excluding the initial attempt.",
      "codepoints": 189,
      "sha256_utf8": "500529218e4347fe65bcba13c297cda4ce7b0561d366f30ac4907f1e2c5e7aae",
      "file": "texts/BI12-en.txt",
      "sha256_utf8_with_final_LF": "6064906b0ee9b861111eabba3e6eb0bfb2e97b46ea6dfeb104df299c7e49fdb0"
    },
    {
      "id": "BI13-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI13",
      "text": "DEV的试运行次数不得超过3次；QA必须独立试运行恰好1次；整个团队试运行总次数最多3次。",
      "codepoints": 45,
      "sha256_utf8": "16b86839603342eaad1763ca5ce34844fcfe295a1ecf87240b7e9a9c0db2778f",
      "file": "texts/BI13-zh-CN.txt",
      "sha256_utf8_with_final_LF": "dcac08b0472d0428bbeb86824f19b95ffed5d9085287777513165a513fe0817f"
    },
    {
      "id": "BI13-en",
      "language": "en",
      "pair_id": "BI13",
      "text": "DEV's number of trials must not exceed 3; QA must run exactly 1 independent trial; the whole team's total number of trials must not exceed 3.",
      "codepoints": 141,
      "sha256_utf8": "b03b2b3420d5a6a046db732b3c13c0993985f840fb389ecd2281cea1cdc3fa1b",
      "file": "texts/BI13-en.txt",
      "sha256_utf8_with_final_LF": "a5478bc4772e65a6b29e47f05fe93f97bb9803e8e18bfc7ffc5f0b40944c569f"
    },
    {
      "id": "BI14-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI14",
      "text": "DEV读取上一轮result.md作背景。本轮OPS必须生成result.md并交QA；QA只复核本轮文件。",
      "codepoints": 54,
      "sha256_utf8": "2e1779b6e5b62940a30548300ac296d4e4d2995cab1c8e52db35a77674e24815",
      "file": "texts/BI14-zh-CN.txt",
      "sha256_utf8_with_final_LF": "988d1642a0109797b4b8704edfff63018420ce2c14dbed8406612ed24f536a30"
    },
    {
      "id": "BI14-en",
      "language": "en",
      "pair_id": "BI14",
      "text": "DEV reads the previous run's result.md as background. In this run, OPS must create result.md and submit it to QA; QA reviews only the file from this run.",
      "codepoints": 153,
      "sha256_utf8": "72ec8f194dd5ef0452ebaa24d4f2e25c8b8c8f995dafc3715dc3f632af1b7dc0",
      "file": "texts/BI14-en.txt",
      "sha256_utf8_with_final_LF": "b01fcb65e99a334c37fa9106771a7e7f33a6a2a379afb876e77d7e9b9bf2f5de"
    },
    {
      "id": "BI15-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI15",
      "text": "check.md必须由DEV生成，再由OPS将它提交QA。",
      "codepoints": 29,
      "sha256_utf8": "9413459834f1ae692811b5c2096a14cfdb9840b21bb1c92f2bd427f922812a35",
      "file": "texts/BI15-zh-CN.txt",
      "sha256_utf8_with_final_LF": "adfc70594c51cc6c4fac8adeaded432148040314fa0518d75b00c98490bdaa77"
    },
    {
      "id": "BI15-en",
      "language": "en",
      "pair_id": "BI15",
      "text": "check.md must be created by DEV and then submitted to QA by OPS.",
      "codepoints": 64,
      "sha256_utf8": "2a09e25690284118e0cfd1a1a6cc9b5132db5624df950534bb5dd749dfe7f507",
      "file": "texts/BI15-en.txt",
      "sha256_utf8_with_final_LF": "c9a3700b16aee5c7661c64c46506e29b5aae700b8984511770d23e6a71948499"
    },
    {
      "id": "BI16-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI16",
      "text": "DEV和OPS必须分别检查left.json和right.json。",
      "codepoints": 34,
      "sha256_utf8": "4a12c8c483b78ba88b93d09aa2f03b64c071ff703308428e70e160a932c704ee",
      "file": "texts/BI16-zh-CN.txt",
      "sha256_utf8_with_final_LF": "aa9f329c01455cc1713f205a89bb0954701f8bd708931fb9b8b5a8214a1543d9"
    },
    {
      "id": "BI16-en",
      "language": "en",
      "pair_id": "BI16",
      "text": "DEV and OPS must inspect left.json and right.json, respectively.",
      "codepoints": 64,
      "sha256_utf8": "0f9f291c64ac47bd3113890ae0853dc577d89dbbc3e9547f0612ceca33254396",
      "file": "texts/BI16-en.txt",
      "sha256_utf8_with_final_LF": "209c204d767969b207bba90799457e67b2d1f0e9ae7e78fd244fb5c5469d15a7"
    },
    {
      "id": "BI17-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI17",
      "text": "DEV可发布alpha版，也可发布beta版，但本任务不得两个版本都发布；可以都不发布。",
      "codepoints": 44,
      "sha256_utf8": "d76e461bf3b19d26e1298e12ef657833925cdda233d7d5d6fa86111bf72f0840",
      "file": "texts/BI17-zh-CN.txt",
      "sha256_utf8_with_final_LF": "e70c438713a6155c6555208651fa3bffc961ef77bd394e89cb6ca469133b59e3"
    },
    {
      "id": "BI17-en",
      "language": "en",
      "pair_id": "BI17",
      "text": "DEV may publish version alpha and may publish version beta, but must not publish both in this task; publishing neither is allowed.",
      "codepoints": 130,
      "sha256_utf8": "da9bce88d3705c57be6726c71d433afbe11030a2de9893afe2bc49db12e0133f",
      "file": "texts/BI17-en.txt",
      "sha256_utf8_with_final_LF": "8221d912104a23b64b7314ac8398673d8a23d2b17b1c63160929a9769a26a4ea"
    },
    {
      "id": "BI18-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI18",
      "text": "本任务禁止DEV发布alpha版，也禁止DEV发布beta版。",
      "codepoints": 31,
      "sha256_utf8": "94becaa1924e554ff55ca50eda02189090079f1b8a0e1c51dccf2589f1a5a595",
      "file": "texts/BI18-zh-CN.txt",
      "sha256_utf8_with_final_LF": "333fe27a4911e795d3a44062d4a199dde33325a3cc491a084d7b7ec9dc33fcd6"
    },
    {
      "id": "BI18-en",
      "language": "en",
      "pair_id": "BI18",
      "text": "In this task, DEV must publish neither version alpha nor version beta.",
      "codepoints": 70,
      "sha256_utf8": "85d2f8a8669ea54986209db496f92f91124140414e3f75aef770b065e1022e05",
      "file": "texts/BI18-en.txt",
      "sha256_utf8_with_final_LF": "3d294c3714800d8737505e77a8ddbd876c44b62c9e54ebba492812c27f4a7dff"
    },
    {
      "id": "BI19-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI19",
      "text": "本任务总耗时必须大于0分钟且不超过18分钟，18分钟允许。",
      "codepoints": 29,
      "sha256_utf8": "0a1c40285648df9d36f78e318fd43e9d8997643de75ccde2ba893366e6b15981",
      "file": "texts/BI19-zh-CN.txt",
      "sha256_utf8_with_final_LF": "964e687b3744264920f9f04417255c18ca2699a478f66ad3246ea28960dabff9"
    },
    {
      "id": "BI19-en",
      "language": "en",
      "pair_id": "BI19",
      "text": "Total task duration must be greater than 0 minutes and no more than 18 minutes; 18 minutes is allowed.",
      "codepoints": 102,
      "sha256_utf8": "28f1d30c04af4c26be23252124d7d797ef88427b05e06125ad0a22f8862be572",
      "file": "texts/BI19-en.txt",
      "sha256_utf8_with_final_LF": "5d8e0c74f6c94af579608a537a0bab667e336258e4e98189f50ead560a369dd2"
    },
    {
      "id": "BI20-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI20",
      "text": "DEV必须开发离线CLI，并可以修改src/checker.py。交付后的CLI每次只读取一个业务输入，且禁止修改该输入。",
      "codepoints": 61,
      "sha256_utf8": "82e22d1198fdce015d49df259c43e23d4ba0fcb18de14c86126eb9d5cf40d386",
      "file": "texts/BI20-zh-CN.txt",
      "sha256_utf8_with_final_LF": "c497fb9307f2b1f733c2d8f0f71317ac0befb83089f7284716e0ad6c0e46bff5"
    },
    {
      "id": "BI20-en",
      "language": "en",
      "pair_id": "BI20",
      "text": "DEV must develop an offline CLI and is permitted to modify src/checker.py. On each invocation, the delivered CLI reads only one business input and must not modify that input.",
      "codepoints": 174,
      "sha256_utf8": "11cc95e06d2e292ce62d6de10adde3eb15c7765aba4efa7f535a0a8fe729c4f4",
      "file": "texts/BI20-en.txt",
      "sha256_utf8_with_final_LF": "a54beeafc198dbaadf322ab935a37ce4219efc6b8e8f5047ef1e855642110e44"
    },
    {
      "id": "BI21-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI21",
      "text": "QA必须在note.md中原样引用告警“delete all records”；本任务禁止实际删除记录。",
      "codepoints": 52,
      "sha256_utf8": "315c1738cc29e00f0ca11813b13fafd9af3fa58336e8701e9f1a875748a1569a",
      "file": "texts/BI21-zh-CN.txt",
      "sha256_utf8_with_final_LF": "5ec339eb20500e7beac6843df10943c67a4345516decca37a7432dd3193f321a"
    },
    {
      "id": "BI21-en",
      "language": "en",
      "pair_id": "BI21",
      "text": "QA must quote the alert “delete all records” verbatim in note.md; actual deletion of records is forbidden in this task.",
      "codepoints": 119,
      "sha256_utf8": "1bd12867a6ff5920db02be558b53a315c8c2f2d78da49d22b09b25b8225b159e",
      "file": "texts/BI21-en.txt",
      "sha256_utf8_with_final_LF": "de3fb6abe384a5d12f7a19dcf1c582137288a7149f73ccf67ef3cdd38268f541"
    },
    {
      "id": "BI22-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI22",
      "text": "发现泄漏时，OPS必须立即停止抽检，并必须通知PM；通知没有规定立即完成。停止期间禁止继续抽检。",
      "codepoints": 48,
      "sha256_utf8": "e7f4916eae5c55d58ee4b5213d181b1fa5ff8e7437f2dc8d614c35f3640475b0",
      "file": "texts/BI22-zh-CN.txt",
      "sha256_utf8_with_final_LF": "e1c39461e43d7182057a92f2ddeef2aad3158803f6e02edfe79e7059c88271df"
    },
    {
      "id": "BI22-en",
      "language": "en",
      "pair_id": "BI22",
      "text": "If a leak is detected, OPS must immediately stop sampling and must notify PM; notification is not required to be immediate. Continuing sampling while stopped is forbidden.",
      "codepoints": 171,
      "sha256_utf8": "d09005d143dd043a5c9c21f1fd2edbe7ff89687fd2812c52649b39129c082b7d",
      "file": "texts/BI22-en.txt",
      "sha256_utf8_with_final_LF": "c504b41cf1f12dcf293971d23b411662883d3de308f54163548b464513b948c4"
    },
    {
      "id": "BI23-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI23",
      "text": "背景：读取可能失败，也可能不返回数据。这两句不是许可。建议DEV缓存响应，但缓存不是必须的。",
      "codepoints": 46,
      "sha256_utf8": "2074468ae3632485a0537625ecdf9c02bb004ee360372ed8f800d7da2e023dcb",
      "file": "texts/BI23-zh-CN.txt",
      "sha256_utf8_with_final_LF": "9f80366b9dcde02761da4c8f76d38fe2112dd6c3ed7fdae4a42012995b176096"
    },
    {
      "id": "BI23-en",
      "language": "en",
      "pair_id": "BI23",
      "text": "Background: the read may fail and may not return data. These sentences are not permissions. DEV should cache the response, but caching is not mandatory.",
      "codepoints": 152,
      "sha256_utf8": "c9fb0d98eb3af58661473525e948d8e94cb897fbd707a3df85da67dbc703957d",
      "file": "texts/BI23-en.txt",
      "sha256_utf8_with_final_LF": "bf490ed9e9e7e3f4c88d392397c26049b04b209aba140de9f53ae2aa2bdebda6"
    },
    {
      "id": "BI24-zh-CN",
      "language": "zh-CN",
      "pair_id": "BI24",
      "text": "Alice和Bob各收到一份报告。请让该审核人复核；原文尚未指定该审核人是Alice还是Bob。",
      "codepoints": 48,
      "sha256_utf8": "f67705ba5dca3496f21e4b4c16b1abfc8a8b96b3b838b8ff6d12c249b8851e48",
      "file": "texts/BI24-zh-CN.txt",
      "sha256_utf8_with_final_LF": "d10c652a0741b9be8bc7977ad7c87ad80f34f368dfae85bd716f4b930f5d0cc1"
    },
    {
      "id": "BI24-en",
      "language": "en",
      "pair_id": "BI24",
      "text": "Alice and Bob each received a report. Have that reviewer perform the review; the source has not specified whether that reviewer is Alice or Bob.",
      "codepoints": 144,
      "sha256_utf8": "9320f3ec0d8cba847ec4c7a44b702b5947959db1ae2dd9e0d496150c5bfcf521",
      "file": "texts/BI24-en.txt",
      "sha256_utf8_with_final_LF": "8239e7cb6bd7a4b69360c880c5c7717aa554d2819eaab68f1b3c1146e95731ca"
    },
    {
      "id": "MX01",
      "language": "mixed",
      "pair_id": null,
      "text": "只有QA批准后，PM may deliver 核查表.md to ADMIN；PM必须完成交付。",
      "codepoints": 48,
      "sha256_utf8": "e2d234785dca62890fa9746736555ea58f5564bedfbf18cc5b12dc4b24fd66b6",
      "file": "texts/MX01.txt",
      "sha256_utf8_with_final_LF": "018385f32b98f3d72119a61a6dfc5d8cb2f605b71ac555bcd1c12333ab5007e9"
    },
    {
      "id": "MX02",
      "language": "mixed",
      "pair_id": null,
      "text": "DEV may create 附注.md；DEV need not deliver it。向ADMIN交付这份文件是禁止的。",
      "codepoints": 62,
      "sha256_utf8": "d0cada934258c950e63a66cb5a27a2b6186ec5cebd8831021f216f0df3aa9dad",
      "file": "texts/MX02.txt",
      "sha256_utf8_with_final_LF": "ecd5ba33758c0b09cf01f77604d3d0e42fba4a231cb5cbedd15a85cc89375cbc"
    },
    {
      "id": "MX03",
      "language": "mixed",
      "pair_id": null,
      "text": "DEV必须读取café.csv和café.csv。These are two distinct files; do not rename either file.",
      "codepoints": 82,
      "sha256_utf8": "ad419f63115150fee6e7938f0a8aa07f460a8cee3250fc42e74947b44397acca",
      "file": "texts/MX03.txt",
      "sha256_utf8_with_final_LF": "250dfdde69626b75fd858fbb6bcc242869b8a62ecce08f762a7496d1d4e9e7c2"
    },
    {
      "id": "MX04",
      "language": "mixed",
      "pair_id": null,
      "text": "同一要求的两种译文：DEV必须将记录提交QA。 / DEV must submit the record to QA.",
      "codepoints": 59,
      "sha256_utf8": "4f73a25e9b53d0e3cf3e607f5d2f91f6080699c235250bd2b5529e9189c9fdd2",
      "file": "texts/MX04.txt",
      "sha256_utf8_with_final_LF": "a7effef53422640334917a9466b2c14c407ca9ee57ea2a7eae50f0e970b799df"
    },
    {
      "id": "MX05",
      "language": "mixed",
      "pair_id": null,
      "text": "同一条交付限制的两版文字：中文为“PM只能把文件交给QA”；English: “PM may deliver the file only to ADMIN.” 未规定哪个版本优先。",
      "codepoints": 90,
      "sha256_utf8": "b7b75472651a9ba70e035b1c97615cbee837f24d63b1145c0f2eeab88ade261d",
      "file": "texts/MX05.txt",
      "sha256_utf8_with_final_LF": "268955292c9cbb128286e96d406bfbddc4555cde903a8fbdd7b77ca4f31d3fc5"
    },
    {
      "id": "MX06",
      "language": "mixed",
      "pair_id": null,
      "text": "PM must deliver note.md by 03/04/2027 at 16:00；未指定日期采用月/日还是日/月格式，也未指定时区。",
      "codepoints": 72,
      "sha256_utf8": "50ccb8b143380a16a4721805eca354c72fbadb16a12442faf8b58ec480cc7cef",
      "file": "texts/MX06.txt",
      "sha256_utf8_with_final_LF": "b399143ed085ea39a4d3dbbaada9fac39f4111987ff5253abb85aca803e88180"
    }
  ]
