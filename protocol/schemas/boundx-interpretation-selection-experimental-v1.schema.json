{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boundx:implementation:interpretation-selection:experimental-v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "selection_id", "reviewer_id", "decision", "task_id", "task_revision", "ir_digest", "formalization_inputs_digest", "canonical_boundary_digest"],
  "properties": {
    "schema": {"const": "boundx-interpretation-selection/experimental-v1"},
    "selection_id": {"$ref": "#/$defs/id"}, "reviewer_id": {"$ref": "#/$defs/id"},
    "decision": {"const": "select_exact_interpretation"},
    "task_id": {"$ref": "#/$defs/id"}, "task_revision": {"$ref": "#/$defs/id"},
    "ir_digest": {"$ref": "#/$defs/digest"}, "formalization_inputs_digest": {"$ref": "#/$defs/digest"},
    "canonical_boundary_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
