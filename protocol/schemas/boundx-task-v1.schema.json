{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boundx:schema:task:v1",
  "title": "BoundX Task Boundary IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocol_version", "task_id", "source", "profile", "elements", "constraints", "extensions"],
  "properties": {
    "schema": { "const": "boundx-task/v1" },
    "protocol_version": { "const": "0.2.0-draft.1" },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "text"],
      "properties": {
        "language": { "type": "string", "minLength": 2, "maxLength": 35 },
        "text": { "type": "string", "minLength": 1, "maxLength": 100000 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required_elements"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+(?:/[a-z0-9._-]+)?$" },
        "required_elements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "enum": ["I", "O", "A", "P", "R", "V", "C", "B"] }
        }
      }
    },
    "elements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["I", "O", "A", "P", "R", "V", "C", "B"],
      "properties": {
        "I": { "$ref": "#/$defs/bucket" },
        "O": { "$ref": "#/$defs/bucket" },
        "A": { "$ref": "#/$defs/bucket" },
        "P": { "$ref": "#/$defs/bucket" },
        "R": { "$ref": "#/$defs/bucket" },
        "V": { "$ref": "#/$defs/bucket" },
        "C": { "$ref": "#/$defs/bucket" },
        "B": { "$ref": "#/$defs/bucket" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervals", "target_sets", "handoffs", "dependencies", "logic"],
      "properties": {
        "intervals": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/interval" } },
        "target_sets": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/targetSet" } },
        "handoffs": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/handoff" } },
        "dependencies": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/dependency" } },
        "logic": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/logicConstraint" } }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+(?:/[a-z0-9._-]+)?$" }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote", "start", "end"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "quote": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
        "text": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/span" } },
        "normalized": { "type": "object" }
      }
    },
    "bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "entries"],
      "properties": {
        "status": { "enum": ["resolved", "unresolved", "absent"] },
        "entries": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/entry" } },
        "reason_codes": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "resolved" } } }, "then": { "properties": { "entries": { "type": "array", "minItems": 1 } } } },
        { "if": { "properties": { "status": { "const": "unresolved" } } }, "then": { "properties": { "entries": { "type": "array", "minItems": 1 }, "reason_codes": { "type": "array", "minItems": 1 } }, "required": ["reason_codes"] } },
        { "if": { "properties": { "status": { "const": "absent" } } }, "then": { "properties": { "entries": { "type": "array", "maxItems": 0 } } } }
      ]
    },
    "bound": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["value", "inclusive"],
      "properties": {
        "value": { "type": "number" },
        "inclusive": { "type": "boolean" }
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "dimension", "unit", "lower", "upper", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 256 },
        "dimension": { "type": "string", "minLength": 1, "maxLength": 128 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 64 },
        "lower": { "$ref": "#/$defs/bound" },
        "upper": { "$ref": "#/$defs/bound" },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/span" } }
      },
      "anyOf": [
        { "required": ["lower"], "properties": { "lower": { "type": "object" } } },
        { "required": ["upper"], "properties": { "upper": { "type": "object" } } }
      ]
    },
    "targetSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "universe", "effect", "actor_scope", "guard_context", "identity_status", "requested", "forbidden", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "universe": { "type": "string", "minLength": 1, "maxLength": 128 },
        "effect": { "type": "string", "minLength": 1, "maxLength": 256 },
        "actor_scope": { "type": "string", "minLength": 1, "maxLength": 256 },
        "guard_context": { "type": "string", "minLength": 1, "maxLength": 512 },
        "requested": { "type": "array", "maxItems": 1024, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "forbidden": { "type": "array", "maxItems": 1024, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "identity_status": { "enum": ["resolved", "unresolved"] },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/span" } }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "producer_stage", "consumer_stage", "artifact_type", "identity_status", "declared_outputs", "required_inputs", "external_inputs", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "producer_stage": { "type": "string", "minLength": 1, "maxLength": 256 },
        "consumer_stage": { "type": "string", "minLength": 1, "maxLength": 256 },
        "artifact_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "identity_status": { "enum": ["resolved", "unresolved"] },
        "declared_outputs": { "type": "array", "maxItems": 1024, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "required_inputs": { "type": "array", "maxItems": 1024, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "external_inputs": { "type": "array", "maxItems": 1024, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/span" } }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind", "evidence"],
      "properties": {
        "from": { "type": "string", "minLength": 1, "maxLength": 256 },
        "to": { "type": "string", "minLength": 1, "maxLength": 256 },
        "kind": { "enum": ["prerequisite", "reference", "information", "iteration"] },
        "max_iterations": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/span" } }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "iteration" } } },
          "then": { "properties": { "max_iterations": { "type": "integer", "minimum": 1, "maximum": 1000000 } }, "required": ["max_iterations"] },
          "else": { "not": { "required": ["max_iterations"] } }
        }
      ]
    },
    "expression": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "object", "additionalProperties": false, "required": ["var"], "properties": { "var": { "type": "string", "minLength": 1, "maxLength": 128 } } },
        { "type": "object", "additionalProperties": false, "required": ["not"], "properties": { "not": { "$ref": "#/$defs/expression" } } },
        { "type": "object", "additionalProperties": false, "required": ["all"], "properties": { "all": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/expression" } } } },
        { "type": "object", "additionalProperties": false, "required": ["any"], "properties": { "any": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/expression" } } } },
        { "type": "object", "additionalProperties": false, "required": ["implies"], "properties": { "implies": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/expression" } } } }
      ]
    },
    "logicConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "variables", "formula", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "variables": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "formula": { "$ref": "#/$defs/expression" },
        "assumptions": { "$ref": "#/$defs/expression" },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/span" } }
      }
    }
  }
}
