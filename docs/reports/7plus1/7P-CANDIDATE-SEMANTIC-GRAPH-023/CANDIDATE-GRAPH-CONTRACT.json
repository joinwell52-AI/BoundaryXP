    "SUPPORTED",
    "COMPETING",
    "INSUFFICIENT",
    "REJECTED"
  ],
  "decision_states": [
    "CERTIFIED",
    "REJECTED",
    "TYPED_UNRESOLVED"
  ],
  "whole_graph_recursively_immutable_before_gamma": false,
  "immutable_semantic_arrays": [
    "semantic_nodes",
    "candidate_relations",
    "candidate_expressions",
    "evidence"
  ],
  "top_level_object_frozen": true,
  "source_and_structure_cloned": true,
