{
  "id": "bxp-core-0.4-gold-v1.bucket-status",
  "protocol_version": "0.4.0-draft.1",
  "scope": "canonical-7plus1-projection",
  "authority": {
    "file": "authority/ADMIN-DECISION-BXP-0.4-CORE-PROFILE-STATUS-FREEZE.md",
    "section": "5"
  },
  "resolved_state": "RESOLVED_ENTRY",
  "open_states": [
    "UNRESOLVED_ENTRY",
    "DEFERRED_ENTRY",
    "UNSUPPORTED_ENTRY",
    "PROJECTION_SLOT_AMBIGUOUS"
  ],
  "ambiguous_assignment": "An ambiguous candidate contributes only to its explicit candidate_slots; never to other slots.",
  "ordered_rules": [
    {
      "when": "Open(S) nonempty",
      "status": "unresolved"
    },
    {
      "when": "Resolved(S) nonempty",
      "status": "resolved"
    },
    {
      "when": "no candidates and complete ResolutionEntry and slot accountability",
      "status": "absent"
    }
  ],
  "incomplete_accountability": {
    "status": null,
    "diagnostic": "INCOMPLETE_PROJECTION_ACCOUNTABILITY",
    "meaning": "Precondition failure; not a fourth public bucket status."
  },
  "invalid_candidate_state": {
    "status": null,
    "diagnostic": "INVALID_CANDIDATE_LEDGER"
  },
  "empty_resolved_bucket_permitted": false,
  "synthesized_none_permitted": false,
  "none_policy": "An explicit evidence-backed none remains a nonempty resolved entry; it never licenses entries=[]. No none is synthesized or inferred.",
  "internal_states_must_be_preserved": true,
  "invariants": [
    "RESOLVED_CANNOT_HIDE_OPEN_CANDIDATE",
    "ABSENT_REQUIRES_COMPLETE_SLOT_ACCOUNTABILITY",
    "EXTRACTION_FAILURE_IS_NOT_ABSENCE",
    "SLOT_STATUS_REDUCTION_IS_NOT_BOUNDARY_RESULT_REDUCTION"
  ],
  "out_of_scope": [
    "boundary determination",
    "profile completeness",
    "formal consistency",
    "admission",
    "release",
    "execution authorization",
    "business decision"
  ]
}
