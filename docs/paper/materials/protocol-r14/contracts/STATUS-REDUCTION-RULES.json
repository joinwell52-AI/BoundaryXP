{
  "protocol_version": "0.4.0-draft.2",
  "document_revision": "2026-10-27-r2",
  "status": "DRAFT_FOR_REVIEW",
  "scope": "entry-to-view reduction contract; not formal consistency or admission",
  "normative_rule": "BXP-STA-002",
  "partial_carrier_rule": "BXP-STA-003",
  "normative_body": "../BXP-0001.md",
  "public_view_states": ["resolved", "unresolved", "absent"],
  "preserved_entry_states": ["RESOLVED_ENTRY", "UNRESOLVED_ENTRY", "DEFERRED_ENTRY", "UNSUPPORTED_ENTRY", "PROJECTION_SLOT_AMBIGUOUS"],
  "precondition": "Complete disposition of the declared projection input for the view, including potentially relevant gaps",
  "ordered_rules": [
    {"when": "Accounted(S) and Open(S) nonempty", "status": "unresolved"},
    {"when": "Accounted(S) and Open(S) empty and Resolved(S) nonempty", "status": "resolved"},
    {"when": "Accounted(S) and Open(S) empty and Resolved(S) empty", "status": "absent"}
  ],
  "incomplete_accountability": {"reduction_complete": false, "view_status_encoding": "OMIT_FIELD", "null_status_permitted": false, "diagnostic": "INCOMPLETE_PROJECTION_ACCOUNTABILITY", "separate_reduction_metadata_required": true, "meaning": "View state has not been produced; neither null nor a fourth public state"},
  "ambiguous_assignment": "Only explicitly evidenced candidate views; no arbitrary duplication",
  "source_coverage_is_separate": true,
  "empty_resolved_view_permitted": false,
  "synthesized_none_permitted": false,
  "contradiction_groups_must_be_preserved": true,
  "missing_required_is_profile_relative": true,
  "out_of_scope": ["natural-language completeness proof", "formal consistency", "boundary determination", "specification preservation", "admission", "execution authorization"],
  "runtime_registered": false
}
