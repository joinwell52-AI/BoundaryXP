{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BoundaryXP custom L2/L3 dictionary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "layer",
    "version",
    "label",
    "entries",
    "business_decision",
    "execution_authorization"
  ],
  "properties": {
    "schema": {
      "const": "boundaryxp-custom-dictionary/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "layer": {
      "enum": [
        "L2",
        "L3"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[a-z0-9]+(?:[.-][a-z0-9]+)*)?$",
      "maxLength": 60
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "tenant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "\\S"
    },
    "language": {
      "enum": [
        "zh-CN",
        "en",
        "multilingual"
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "terms",
          "definition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
          },
          "terms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "\\S"
            }
          },
          "definition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000,
            "pattern": "\\S"
          },
          "canonical": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "environment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "directories": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            }
          },
          "system": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "operation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "department": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "job_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "manager_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "subject_type": {
            "enum": [
              "human",
              "agent",
              "service",
              "team"
            ]
          },
          "role_ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        }
      }
    },
    "business_decision": {
      "type": "null"
    },
    "execution_authorization": {
      "type": "null"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "layer": {
            "const": "L3"
          }
        }
      },
      "then": {
        "required": [
          "tenant"
        ]
      }
    }
  ]
}
