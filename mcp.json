{
  "mcpServers": {
    "BoundaryXP": {
      "command": "npx.cmd",
      "args": ["--yes", "boundaryxp-mcp@0.4.0-rc.7", "--data-root", "${BXP_DATA_ROOT}", "--profiles", "${BXP_PROFILES_FILE}"],
      "env": {
        "CURSOR_API_KEY": "${CURSOR_API_KEY}",
        "BOUNDARYXP_API_BASE_URL": "${BOUNDARYXP_API_BASE_URL}",
        "BOUNDARYXP_API_KEY": "${BOUNDARYXP_API_KEY}"
      }
    }
  }
}
