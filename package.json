{
  "name": "@boundaryxp/core",
  "displayName": "界痕 · BoundaryXP",
  "version": "1.3.0-preview.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/joinwell52-AI/BoundaryXP.git"
  },
  "type": "module",
  "description": "BoundaryXP: an embeddable and service-ready task boundary preflight engine with evidence-linked 7+1 validation",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": "./src/index.ts",
  "dependencies": {
    "@cursor/sdk": "1.0.30",
    "ajv": "8.20.0",
    "z3-solver": "5.2.0"
  },
  "bin": {
    "bx": "./cli.mjs"
  },
  "overrides": {
    "undici": "6.28.0"
  },
  "scripts": {
    "test:workbench": "node --test --test-concurrency=1 tests/boundary-*.test.mjs tests/boolean-boundary-comparison.test.mjs tests/direct-ir-*.test.mjs tests/ui220-*.test.mjs tests/ir-kernel/*.test.mjs",
    "7plus1:build-candidate": "node product/short-compiler/build-candidate.mjs",
    "7plus1": "node research/7plus1-parser/llm-first-028/cli.mjs",
    "7plus1:ui": "node product/short-compiler/launch-installed.mjs",
    "7plus1:installed": "node product/short-compiler/cli-installed.mjs",
    "test:real-project": "python fixtures/real-project/BoundaryXP-REAL-GOLD-P001-v0.1/validate_cases.py && node --test tests/real-project-cases.test.mjs",
    "research:real-project:prepare": "node scripts/prepare-real-project-benchmark.mjs",
    "research:real-project:probe": "node scripts/run-real-project-probes.mjs",
    "research:compare": "node scripts/score-producer-comparison.mjs",
    "test:research:local": "node scripts/test-research-local.mjs",
    "verify:semantic-resources": "node scripts/verify-semantic-resources.mjs",
    "test": "python fixtures/real-project/BoundaryXP-REAL-GOLD-P001-v0.1/validate_cases.py && npm run test:gold:data",
    "test:gold:data": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:gold:integrity": "npm run test:real-project",
    "mcp": "node mcp.mjs",
    "ui": "node ui-server.mjs --open"
  }
}
