{
  "name": "@boundx/core",
  "displayName": "界痕 · BoundX",
  "version": "1.2.4-preview.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/joinwell52-AI/BoundX.git"
  },
  "type": "module",
  "description": "BoundX: an embeddable and service-ready task boundary preflight engine with evidence-linked 7+1 validation",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": "./src/index.ts",
  "dependencies": {
    "ajv": "8.20.0"
  },
  "bin": {
    "bx": "./cli.mjs"
  },
  "scripts": {
    "test": "npm run test:core && npm run test:protocol",
    "test:core": "node --test src/__tests__/*.test.ts",
    "test:protocol": "node --test protocol/conformance/*.test.mjs && node protocol/conformance/run.mjs",
    "protocol:build": "node protocol/conformance/build-suite.mjs && node protocol/provenance/build-manifest.mjs",
    "protocol:manifest": "node protocol/provenance/build-manifest.mjs",
    "mcp": "node mcp.mjs",
    "ui": "node ui-server.mjs --open",
    "test:ui": "node --test ui/*.test.mjs",
    "test:docs": "python -X utf8 -m unittest discover -s scripts -p test_*.py && python -X utf8 scripts/check-doc-links.py"
  }
}
