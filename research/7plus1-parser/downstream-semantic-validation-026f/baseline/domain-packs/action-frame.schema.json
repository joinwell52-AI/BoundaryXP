{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundx.local/schema/domain-action-frames-v1.json",
  "title": "BoundaryXP layered domain action frame pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packId",
    "version",
    "invariants",
    "roleContracts",
    "projectionContracts",
    "frames"
  ],
  "properties": {
    "schema": {
      "const": "boundx-domain-actions/v1"
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "invariants": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "roleContracts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "primaryRole",
          "optionalRoles"
        ],
        "properties": {
          "operation": {
            "enum": [
              "READ",
              "CREATE",
              "SEND",
              "EMIT",
              "PROCESS",
              "CHANGE",
              "CALL"
            ]
          },
          "primaryRole": {
            "enum": [
              "input",
              "artifact",
              "payload",
              "target",
              "interface"
            ]
          },
          "optionalRoles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "executor",
                "recipient"
              ]
            }
          }
        }
      }
    },
    "projectionContracts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "candidates"
        ],
        "properties": {
          "operation": {
            "enum": [
              "READ",
              "CREATE",
              "SEND",
              "EMIT",
              "PROCESS",
              "CHANGE",
              "CALL"
            ]
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "basis"
              ],
              "properties": {
                "field": {
                  "enum": [
                    "I",
                    "O",
                    "A",
                    "P",
                    "R",
                    "V",
                    "C",
                    "B"
                  ]
                },
                "basis": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "label",
          "operation",
          "roleContract",
          "projectionContract",
          "entityTypes",
          "triggers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9_]*$"
          },
          "category": {
            "type": "string"
          },
          "label": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zh-CN",
              "en"
            ],
            "properties": {
              "zh-CN": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "operation": {
            "enum": [
              "READ",
              "CREATE",
              "SEND",
              "EMIT",
              "PROCESS",
              "CHANGE",
              "CALL"
            ]
          },
          "roleContract": {
            "type": "string"
          },
          "projectionContract": {
            "type": "string"
          },
          "entityTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "triggers": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "zh",
              "en"
            ],
            "properties": {
              "zh": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "en": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
