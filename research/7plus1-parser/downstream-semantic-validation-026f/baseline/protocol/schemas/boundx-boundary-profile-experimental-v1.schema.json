{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boundx:implementation:boundary-profile:experimental-v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "id", "version", "required_elements", "operator_profile"],
  "properties": {
    "schema": {"const": "boundx-boundary-profile/experimental-v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "required_elements": {"type": "array", "maxItems": 8, "uniqueItems": true,
      "items": {"enum": ["I", "O", "A", "P", "R", "V", "C", "B"]}},
    "operator_profile": {"const": "boundx.typed-operators/experimental-v1"}
  }
}
