{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boundx:implementation:semantic-ir:experimental-v1",
  "title": "BoundX experimental semantic carrier; not BXP 0.4 conformance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocol_target", "task_id", "task_revision", "sources", "scopes", "elements"],
  "properties": {
    "schema": {"const": "boundx-semantic-ir/experimental-v1"},
    "protocol_target": {"const": "0.4.0-draft.1"},
    "task_id": {"$ref": "#/$defs/id"},
    "task_revision": {"$ref": "#/$defs/id"},
    "sources": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/source"}},
    "scopes": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/scope"}},
    "elements": {
      "type": "object", "additionalProperties": false,
      "required": ["I", "O", "A", "P", "R", "V", "C", "B"],
      "properties": {
        "I": {"$ref": "#/$defs/bucket"}, "O": {"$ref": "#/$defs/bucket"},
        "A": {"$ref": "#/$defs/bucket"}, "P": {"$ref": "#/$defs/bucket"},
        "R": {"$ref": "#/$defs/bucket"}, "V": {"$ref": "#/$defs/bucket"},
        "C": {"$ref": "#/$defs/bucket"}, "B": {"$ref": "#/$defs/bucket"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "language", "text", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["task", "context"]},
        "language": {"type": "string", "minLength": 2, "maxLength": 35},
        "text": {"type": "string", "minLength": 1, "maxLength": 100000},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "evidence": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "start", "end", "quote"],
        "properties": {
          "source_id": {"$ref": "#/$defs/id"},
          "start": {"type": "integer", "minimum": 0, "maximum": 100000},
          "end": {"type": "integer", "minimum": 1, "maximum": 100000},
          "quote": {"type": "string", "minLength": 1, "maxLength": 100000}
        }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "description", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "status": {"enum": ["resolved", "unresolved"]},
        "description": {"type": "string", "minLength": 1, "maxLength": 10000},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "bucket": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "coverage", "entries"],
      "properties": {
        "status": {"enum": ["resolved", "unresolved", "absent"]},
        "coverage": {"enum": ["assessed", "not_assessed", "unsupported"]},
        "entries": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/entry"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "resolved"}}}, "then": {
          "properties": {"coverage": {"const": "assessed"}, "entries": {"type": "array", "minItems": 1,
            "items": {"type": "object", "properties": {"status": {"const": "resolved"}}}}}}},
        {"if": {"properties": {"status": {"const": "absent"}}}, "then": {
          "properties": {"coverage": {"const": "assessed"}, "entries": {"type": "array", "maxItems": 0}}}}
      ]
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "kind", "text", "scope_id", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "status": {"enum": ["resolved", "unresolved"]},
        "kind": {"$ref": "#/$defs/id"},
        "text": {"type": "string", "minLength": 1, "maxLength": 10000},
        "scope_id": {"$ref": "#/$defs/id"}, "evidence": {"$ref": "#/$defs/evidence"}
      }
    }
  }
}
