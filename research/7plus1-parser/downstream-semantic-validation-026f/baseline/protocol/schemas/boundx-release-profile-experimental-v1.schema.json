{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boundx:implementation:release-profile:experimental-v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "id", "version", "boundary_profile", "release_conditions"],
  "properties": {
    "schema": {"const": "boundx-release-profile/experimental-v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "boundary_profile": {"$ref": "urn:boundx:implementation:boundary-profile:experimental-v1"},
    "release_conditions": {"type": "array", "maxItems": 256, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S"}}
  }
}
