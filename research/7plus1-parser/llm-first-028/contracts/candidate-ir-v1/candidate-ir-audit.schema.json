{
  "type": "object",
  "properties": {
    "format": {
      "const": "boundx-candidate-ir-audit/1"
    },
    "contract_version": {
      "const": "candidate-ir/1.4"
    },
    "source_table": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "occurrence": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "quote",
          "occurrence"
        ],
        "additionalProperties": false
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "$ref": "#/$defs/ref"
          },
          "field_path": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "SUPPORT",
              "CONTRADICT",
              "UNCERTAIN"
            ]
          },
          "context_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "target",
          "field_path",
          "verdict",
          "context_refs",
          "source_refs",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "affected_views": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "I",
                "O",
                "A",
                "P",
                "R",
                "V",
                "C",
                "B"
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_refs",
          "affected_views",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "targets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "field_path": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "targets",
          "field_path",
          "source_refs",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "contract_version",
    "source_table",
    "reviews",
    "omissions",
    "issues"
  ],
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ENTITY",
            "VARIABLE",
            "EVENT",
            "STATE",
            "EXPRESSION",
            "REQUIREMENT"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    }
  }
}
